# Mẫu biến môi trường — sao chép thành .env.local khi chạy thử (không commit file .env thật — .gitignore đã chặn .env*)
# Đặt các biến này trong Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Khoá service role: CHỈ dùng phía máy chủ, không đưa vào frontend
SUPABASE_SERVICE_ROLE_KEY=

# Mã truy cập dùng chung cho bản demo (để trống = API mở). Frontend gửi qua header x-clinic-key (VITE_CLINIC_API_KEY)
CLINIC_API_KEY=
VITE_CLINIC_API_KEY=

# Số lần gọi API tối đa mỗi phút cho một IP (mặc định 120)
CLINIC_RATE_LIMIT=

# memory = chạy API bằng kho trong bộ nhớ, không cần Supabase (thử nhanh)
CLINIC_DATA=
